{
    "instructions": [
        {
            "type": "STEP",
            "text": "Prepare 300 g of coffee with the moka, sweeten to taste, and let it cool in a wide, shallow bowl. Separate the eggs, dividing the whites from the yolks. Ensure no yolk traces remain in the whites. Beat the yolks with half of the sugar until light and frothy. Gradually add the mascarpone while mixing.",
            "annotations": [
                {
                    "type": "INGREDIENT",
                    "data": {
                        "description": "300 g Coffee"
                    },
                    "position": {
                        "offset": 8,
                        "length": 13
                    }
                },
                {
                    "type": "INGREDIENT",
                    "data": {
                        "description": "260 g Fresh eggs"
                    },
                    "position": {
                        "offset": 117,
                        "length": 17
                    }
                },
                {
                    "type": "INGREDIENT",
                    "data": {
                        "description": "120 g Sugar"
                    },
                    "position": {
                        "offset": 207,
                        "length": 12
                    }
                },
                {
                    "type": "INGREDIENT",
                    "data": {
                        "description": "750 g Mascarpone"
                    },
                    "position": {
                        "offset": 256,
                        "length": 17
                    }
                }
            ]
        },
        {
            "type": "STEP",
            "text": "Once all the mascarpone is incorporated, you will have a thick and compact cream. Set aside. Clean the beaters well and beat 3 min/speed 7 the 260 g Fresh eggs (about 5 medium) egg whites. When foamy, gradually add the remaining sugar.",
            "annotations": [
                {
                    "type": "TTS",
                    "data": {
                        "speed": "7",
                        "time": 180
                    },
                    "position": {
                        "offset": 125,
                        "length": 13
                    }
                },
                {
                    "type": "INGREDIENT",
                    "data": {
                        "description": "260 g Fresh eggs (about 5 medium)"
                    },
                    "position": {
                        "offset": 143,
                        "length": 33
                    }
                }
            ]
        },
        {
            "type": "STEP",
            "text": "Beat the egg whites until stiff peaks form. Add a spoonful of egg whites to the mascarpone cream and mix vigorously with a spatula. Then, gently fold in the remaining egg whites, little by little, using an upward motion."
        },
        {
            "type": "STEP",
            "text": "The mascarpone cream is now ready. Spread a generous spoonful on the bottom of a 30x19.5 cm glass dish. Dip the savoiardi briefly in the cold coffee, first on one side, then the other.",
            "annotations": [
                {
                    "type": "INGREDIENT",
                    "data": {
                        "description": "250 g Savoiardi"
                    },
                    "position": {
                        "offset": 160,
                        "length": 15
                    }
                }
            ]
        },
        {
            "type": "STEP",
            "text": "Arrange the soaked savoiardi in the dish, aligning them in one direction to form the first layer. Add more mascarpone cream and spread evenly to cover."
        },
        {
            "type": "STEP",
            "text": "Continue layering the soaked savoiardi, then add another layer of cream and smooth the surface."
        },
        {
            "type": "STEP",
            "text": "Transfer the remaining cream into a piping bag with a 12 mm plain nozzle and pipe dollops over the entire dish. Dust with cocoa powder and refrigerate for a couple of hours. Your tiramisù is ready to enjoy!",
            "annotations": [
                {
                    "type": "INGREDIENT",
                    "data": {
                        "description": "Cocoa powder"
                    },
                    "position": {
                        "offset": 122,
                        "length": 12
                    }
                }
            ]
        }
    ]
}


